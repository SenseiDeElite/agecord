{
  "manifest_version": 3,
  "name": "Discord Age Encryption",
  "version": "0.7.3",
  "description": "End-to-end post-quantum age encryption for Discord.",
  "browser_specific_settings": {
    "gecko": {
      "id": "{19e0c78a-600a-4739-8977-56ca5741df7e}",
      "strict_min_version": "152.0",
      "update_url": "https://raw.githubusercontent.com/SenseiDeElite/discord-age-encryption/refs/heads/main/updates.json",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "icons": {
    "512": "icons/icon-512.svg"
  },
  "permissions": [
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "https://discord.com/*",
    "https://cdn.discordapp.com/*"
  ],
  "background": {
    "scripts": [
      "background.js"
    ],
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://discord.com/channels/*"
      ],
      "js": [
        "content/upload-interceptor.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://discord.com/channels/*"
      ],
      "js": [
        "content/content-loader.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Discord Age Encryption"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'none';"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "content/content.js",
        "content/emoji_map.js",
        "content/highlight_map.js",
        "content/file-crypto-worker.js",
        "content/cdn-bridge.html",
        "content/cdn-bridge.js",
        "lib/age.min.js",
        "lib/rustcrypto-wasm.min.js"
      ],
      "matches": ["https://discord.com/*"]
    }
  ]
}
