{
  "manifest_version": 3,
  "name": "Agecord",
  "version": "0.8.2",
  "minimum_chrome_version": "148",
  "update_url": "https://raw.githubusercontent.com/SenseiDeElite/agecord/main/updates.xml",
  "description": "End-to-end post-quantum age encryption for Discord.",
  "icons": {
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "https://discord.com/*",
    "https://cdn.discordapp.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://discord.com/channels/*"
      ],
      "js": [
        "content/upload-interceptor.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://discord.com/channels/*"
      ],
      "js": [
        "content/content-loader.js"
      ],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Agecord"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'none';"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "content/content.js",
        "content/emoji_map.js",
        "content/highlight_map.js",
        "content/file-crypto-worker.js",
        "content/cdn-bridge.html",
        "content/cdn-bridge.js",
        "lib/age.min.js",
        "lib/rustcrypto-wasm.min.js"
      ],
      "matches": ["https://discord.com/*"]
    }
  ]
}
